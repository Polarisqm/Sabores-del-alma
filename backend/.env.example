# copia este archivo como .env y llena tus valores (el .env nunca se sube a GitHub)
PUERTO=3000

# datos de tu servicio en Aiven (los ves en la página "Overview" del servicio)
DB_HOST=tu-servicio-tu-proyecto.aivencloud.com
DB_PUERTO=12345
DB_USUARIO=avnadmin
DB_CLAVE=la_contraseña_que_te_muestra_aiven
DB_NOMBRE=sabores_del_alma
# el certificado se descarga de Aiven y se guarda en esta carpeta
DB_CA_RUTA=./certificados/ca.pem

# una frase larga y al azar, sirve para firmar los tokens de login
JWT_SECRETO=pon_aqui_una_frase_larga_y_al_azar
# direcciones desde donde se abre la página, separadas por coma
FRONTEND_URL=http://127.0.0.1:5500,http://localhost:5500
